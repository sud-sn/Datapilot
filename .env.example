# ═══════════════════════════════════════════════════════════
# DataPilot Configuration
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in your values:  cp .env.example .env

# ── Data Source (REQUIRED — choose one) ──────────────────
# Options: snowflake, postgresql
DATAPILOT_DB_SOURCE=snowflake

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SNOWFLAKE CONFIG (use when DB_SOURCE=snowflake)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATAPILOT_DB_ACCOUNT=your_account.us-east-1
DATAPILOT_DB_USER=your_username
DATAPILOT_DB_PASSWORD=your_password
DATAPILOT_DB_WAREHOUSE=COMPUTE_WH
DATAPILOT_DB_DATABASE=ANALYTICS_DB
DATAPILOT_DB_SCHEMA=PUBLIC
DATAPILOT_DB_ROLE=READONLY_ROLE

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# POSTGRESQL CONFIG (use when DB_SOURCE=postgresql)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATAPILOT_DB_HOST=localhost
# DATAPILOT_DB_PORT=5432
# DATAPILOT_DB_USER=your_pg_user
# DATAPILOT_DB_PASSWORD=your_pg_password
# DATAPILOT_DB_DATABASE=analytics
# DATAPILOT_DB_SCHEMA=public
# DATAPILOT_DB_SSL_MODE=prefer

# ── LLM Provider ────────────────────────────────────────
# Groq FREE tier (recommended — best quality at $0)
DATAPILOT_LLM_PROVIDER=groq
DATAPILOT_LLM_MODEL=llama-3.3-70b-versatile
DATAPILOT_API_KEY=your_groq_api_key

# Ollama (local, free)
# DATAPILOT_LLM_PROVIDER=ollama
# DATAPILOT_LLM_MODEL=qwen2.5-coder:7b

# ── Security ────────────────────────────────────────────
DATAPILOT_DB_QUERY_TIMEOUT=30
DATAPILOT_MAX_RESULT_ROWS=10000

# ── Performance ─────────────────────────────────────────
DATAPILOT_CACHE_ENABLED=true
DATAPILOT_CACHE_TTL=3600
DATAPILOT_INCLUDE_SAMPLE_VALUES=true

# ── Server ──────────────────────────────────────────────
DATAPILOT_HOST=0.0.0.0
DATAPILOT_PORT=8000
